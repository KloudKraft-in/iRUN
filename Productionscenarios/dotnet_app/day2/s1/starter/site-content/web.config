<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files><clear /><add value="index.html" /></files>
    </defaultDocument>
    <httpProtocol>
      <customHeaders><add name="X-Lab" value="NET-D2-201" /></customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>

